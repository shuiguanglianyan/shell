[Unit]
Description=Mihomo (Clash Meta) Proxy Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.config/mihomo
ExecStart=/usr/local/bin/mihomo -d /root/.config/mihomo -f /root/.config/mihomo/sub.yaml 
Restart=always
RestartSec=3
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
